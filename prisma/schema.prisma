  @@index([occurredAt], map: "IDX_95b455d81d8816e949204369e1")
  @@index([userId], map: "IDX_aa70957efd8d4aef182e067b19")
  @@index([anonymousSessionId], map: "IDX_b0fce3063c49ba788bb89dacce")
}

model users {
  id                      Int                   @id @unique(map: "IDX_16d4f7d636df336db11d87413e") @default(autoincrement())
  createdAt               DateTime              @default(now()) @db.DateTime(6)
  updatedAt               DateTime              @default(now()) @db.DateTime(6)
  username                String                @unique(map: "IDX_ffc81a3b97dcbf8e320d5106c0") @db.VarChar(255)
  password                String                @db.VarChar(255)
  roles                   users_roles
  email                   String                @unique(map: "IDX_3c3ab3f49a87e6ddb607f3c494") @db.VarChar(255)
  nom                     String                @db.VarChar(255)
  prenom                  String                @db.VarChar(255)
  telephone               String                @unique(map: "IDX_7bf57c28a8238d97fd51943544") @db.VarChar(255)
  numero_paiment          String?               @db.VarChar(255)
  cin                     String?               @db.VarChar(255)
  photo                   String?               @db.VarChar(255)
  tpe                     String?               @db.VarChar(255)
  placeName               String?               @db.VarChar(255)
  addressePersonnelle     String?               @db.VarChar(255)
  addresseProfessionnelle String?               @db.VarChar(255)
  commentaire             String?               @db.VarChar(255)
  latitude                String?               @db.VarChar(255)
  longitude               String?               @db.VarChar(255)
  isDelete                Int                   @default(0) @db.TinyInt
  firstConnection         Int                   @default(0) @db.TinyInt
  active                  Int?                  @db.TinyInt
  ip_address              String?               @db.VarChar(255)
  created_on              Int?
  isRestricted            Int?                  @db.TinyInt
  restrictDate            DateTime?             @db.DateTime(0)
  cin_verso               String?               @db.VarChar(255)
  lastActiveAt            DateTime?             @db.DateTime(0)
  isCurrentlyActive       Int                   @default(0) @db.TinyInt
  chauffeurs              chauffeurs?
  clients                 clients?
  feed_back               feed_back[]
  notification_tokens     notification_tokens[]
  position                position[]
}

model vehicules {
  id              Int            @id @default(autoincrement())
  immatriculation String         @db.VarChar(255)
  type            vehicules_type @default(PARTICULIER)
  licence         String?        @db.VarChar(255)
  marque          String         @db.VarChar(255)
  photo           String?        @db.VarChar(255)
  annee           String         @db.VarChar(255)
  chauffeurs      chauffeurs[]
}

model villes {
  id                                    Int       @id @default(autoincrement())
  nom                                   String    @db.VarChar(255)
  trajets_trajets_VilleArriveIdTovilles trajets[] @relation("trajets_VilleArriveIdTovilles")
  trajets_trajets_VilleDepartIdTovilles trajets[] @relation("trajets_VilleDepartIdTovilles")
}

enum vehicules_type {
  TAXI
  MOTO
  PARTICULIER
}

enum courses_etat {
  EN_COURS                 @map("EN COURS")
  EN_ATTENTE_DU_CHAUFFEUR  @map("EN ATTENTE DU CHAUFFEUR")
  ANNULER_PAR_LE_CHAUFFEUR @map("ANNULER PAR LE CHAUFFEUR")
  ANNULER_PAR_LE_CLIENT    @map("ANNULER PAR LE CLIENT")
  TERMINER
}

enum trajets_etat {
  EN_COURS @map("EN COURS")
  VALIDER
  ANNULER
}

enum useractivityhistory_activityType {
  AUTH_HEARTBEAT
  ANON_HEARTBEAT
  MARK_INACTIVE
  STATUS_CHANGE
}

enum courses_modePayement {
  TELMA
  ORANGE
  AIRTEL
  TPE
}

enum requeststats_available {
  yes
  no
}

enum users_roles {
  ROLE_CLIENT
  ROLE_CHAUFFEUR
}

enum courses_qrCodeScannerStatus {
  NOT_INIT
  INIT
  SUCCESS
  FAILED
}
