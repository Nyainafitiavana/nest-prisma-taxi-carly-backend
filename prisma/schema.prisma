generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model api_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.DateTime(0)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ci_sessions {
  id         String @db.VarChar(40)
  ip_address String @db.VarChar(45)
  timestamp  Int    @default(0) @db.UnsignedInt
  data       Bytes  @db.Blob

  @@index([timestamp], map: "ci_sessions_timestamp")
  @@ignore
}

model feed_back {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @db.DateTime(6)
  updatedAt    DateTime @default(now()) @db.DateTime(6)
  feedbackText String?  @db.Text
  rating       Int
  userId       Int?
  trajetId     Int?
  Trajets      trajets? @relation(fields: [trajetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_1fae34859254ccb1e901d78c5d7")
  Users        users?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_2573929a556334405fbbcbc4676")

  @@index([trajetId], map: "FK_1fae34859254ccb1e901d78c5d7")
  @@index([userId], map: "FK_2573929a556334405fbbcbc4676")
}

model groups {
  id           Int            @id @default(autoincrement()) @db.UnsignedMediumInt
  name         String         @db.VarChar(20)
  description  String         @db.VarChar(100)
  users_groups users_groups[]
}

model historique {
  historique_id              Int       @id @default(autoincrement()) @db.UnsignedInt
  historiquetype_id          Int?
  user_id                    Int       @db.UnsignedInt
  historique_date            DateTime? @default(now()) @db.DateTime(0)
  historique_description     String?   @db.VarChar(250)
  historique_ancien_valeur   String?   @db.VarChar(250)
  historique_nouvelle_valeur String?   @db.VarChar(250)
}

model historiquetype {
  historiquetype_id  Int     @id @default(autoincrement()) @db.UnsignedInt
  historiquetype_nom String? @db.VarChar(100)
}

model login_attempts {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  ip_address String @db.VarChar(15)
  login      String @db.VarChar(100)
  time       Int?   @db.UnsignedInt
}

model notification_tokens {
  id                 Int             @id @default(autoincrement())
  device_type        String          @db.VarChar(255)
  notification_token String          @db.VarChar(255)
  status             String          @default("ACTIVE") @db.VarChar(255)
  user_id            Int?
  typeUser           String          @db.VarChar(255)
  Users              users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_046760648e82c2ae7c5253d1a14")
  notifications      notifications[]

  @@index([user_id], map: "FK_046760648e82c2ae7c5253d1a14")
}

model notifications {
  id                    Int                  @id @default(autoincrement())
  title                 String               @db.VarChar(255)
  body                  String?              @db.LongText
  created_by            String               @db.VarChar(255)
  status                String               @default("ACTIVE") @db.VarChar(255)
  notification_token_id Int?
  notification_tokens   notification_tokens? @relation(fields: [notification_token_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d331ebcf7a9f66159540609addb")

  @@index([notification_token_id], map: "FK_d331ebcf7a9f66159540609addb")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model parametres {
  id          Int     @default(autoincrement()) @db.UnsignedInt
  key         String? @unique(map: "unique_key_parametre_key") @db.VarChar(50)
  description String? @db.LongText

  @@index([id], map: "primary_key_parametre_id")
  @@ignore
}

model position {
  id        Int      @id @default(autoincrement())
  terminate Int      @default(0) @db.TinyInt
  userId    Int?
  trajetId  Int?
  lat       Decimal  @db.Decimal(10, 4)
  long      Decimal  @db.Decimal(10, 4)
  Users     users?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_039f90c019013ef5d8d032f32f1")
  Trajets   trajets? @relation(fields: [trajetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_53ff6135bfb022d24742f991716")

  @@index([userId], map: "FK_039f90c019013ef5d8d032f32f1")
  @@index([trajetId], map: "FK_53ff6135bfb022d24742f991716")
}

model users_groups {
  id         Int        @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int        @db.UnsignedInt
  group_id   Int        @db.UnsignedMediumInt
  groups     groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_groups_groups1")
  usersappli usersappli @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_groups_users1")

  @@unique([user_id, group_id], map: "uc_users_groups")
  @@index([group_id], map: "fk_users_groups_groups1_idx")
  @@index([user_id], map: "fk_users_groups_users1_idx")
}

model usersappli {
  id                      Int            @id @default(autoincrement()) @db.UnsignedInt
  ip_address              String         @db.VarChar(45)
  username                String?        @db.VarChar(100)
  password                String         @db.VarChar(255)
  salt                    String?        @db.VarChar(255)
  email                   String         @db.VarChar(100)
  activation_code         String?        @db.VarChar(40)
  forgotten_password_code String?        @db.VarChar(40)
  forgotten_password_time Int?           @db.UnsignedInt
  remember_code           String?        @db.VarChar(40)
  created_on              Int            @db.UnsignedInt
  last_login              Int?           @db.UnsignedInt
  active                  Int?           @db.UnsignedTinyInt
  first_name              String?        @db.VarChar(50)
  genre                   String         @db.VarChar(10)
  last_name               String?        @db.VarChar(50)
  company                 String?        @db.VarChar(100)
  phone                   String?        @db.VarChar(20)
  passwd                  String         @db.VarChar(20)
  adresse                 String         @db.VarChar(50)
  code_postal             String         @db.VarChar(10)
  ville                   String         @db.VarChar(30)
  adresse_compl           String         @db.VarChar(60)
  users_groups            users_groups[]
}

model anonymoususersessions {
  id                Int      @id @default(autoincrement())
  sessionId         String   @unique(map: "IDX_ca0476a142ad4b8858e1b1133c") @db.VarChar(255)
  ipAddress         String?  @db.VarChar(255)
  userAgent         String?  @db.VarChar(255)
  deviceType        String?  @db.VarChar(255)
  lastActiveAt      DateTime @db.DateTime(0)
  isCurrentlyActive Int      @default(1) @db.TinyInt
  createdAt         DateTime @db.DateTime(0)
  latitude          String?  @db.VarChar(255)
  longitude         String?  @db.VarChar(255)
}

model chauffeurs {
  id           Int            @id @default(autoincrement())
  note         Int            @default(0)
  numPermis    String         @db.VarChar(255)
  vehiculeId   Int
  userId       Int            @unique(map: "REL_8827e665f55368801919a69946")
  permis       String?        @db.VarChar(255)
  inCourse     Int?           @db.TinyInt
  facebookId   String?        @db.VarChar(255)
  vehicules    vehicules      @relation(fields: [vehiculeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_1a5761f09fe06f91512d97b5be3")
  users        users          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8827e665f55368801919a699463")
  courses      courses[]
  propositions propositions[]

  @@index([vehiculeId], map: "FK_1a5761f09fe06f91512d97b5be3")
}

model clients {
  id      Int       @id @default(autoincrement())
  userId  Int?      @unique(map: "REL_fe6f86b19ca91c2943a67a3db2")
  users   users?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_fe6f86b19ca91c2943a67a3db2d")
  trajets trajets[]
}

model conversations {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now()) @db.DateTime(6)
  updatedAt     DateTime @default(now()) @db.DateTime(6)
  request_id    String?  @db.VarChar(255)
  state         String   @db.VarChar(255)
  departure     String?  @db.VarChar(255)
  departureTime String?  @db.VarChar(255)
  timestamp     BigInt
  arrival       String?  @db.VarChar(255)
  price         Int?
  driverId      String   @db.VarChar(255)
}

model courses {
  id                    Int                         @id @default(autoincrement())
  createdAt             DateTime                    @default(now()) @db.DateTime(6)
  updatedAt             DateTime                    @default(now()) @db.DateTime(6)
  etat                  courses_etat
  modePayement          courses_modePayement
  depLongChauff         Decimal                     @db.Decimal(10, 0)
  depLatChauff          Decimal                     @db.Decimal(10, 0)
  finishedByClient      Int                         @default(0) @db.TinyInt
  finishedByDriver      Int                         @default(0) @db.TinyInt
  finishedAt            DateTime?                   @db.DateTime(0)
  TrajetId              Int?
  ChauffeurId           Int?
  isDelete              Int                         @default(0) @db.TinyInt
  isDriverCloseToClient Int                         @default(0) @db.TinyInt
  qrCodeScannerStatus   courses_qrCodeScannerStatus @default(NOT_INIT)
  isPaid                Int                         @default(0) @db.TinyInt
  chauffeurs            chauffeurs?                 @relation(fields: [ChauffeurId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_119bd3a11ee4be14b1e5345d2f8")
  trajets               trajets?                    @relation(fields: [TrajetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d61d551a21e3258dcffce5efc9e")
  payments              payments?

  @@index([ChauffeurId], map: "FK_119bd3a11ee4be14b1e5345d2f8")
  @@index([TrajetId], map: "FK_d61d551a21e3258dcffce5efc9e")
}

model fbmessage {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @db.DateTime(6)
  updatedAt       DateTime @default(now()) @db.DateTime(6)
  senderId        String   @db.VarChar(255)
  lastMessage     String   @db.VarChar(255)
  lastMessageDate DateTime @default(now()) @db.Timestamp(6)
}

model parametre {
  id                                  Int      @id @default(autoincrement())
  createdAt                           DateTime @default(now()) @db.DateTime(6)
  updatedAt                           DateTime @default(now()) @db.DateTime(6)
  rayonDecouvertureTrajet             Int      @default(5)
  trajetExpirationTime                Int      @default(30)
  TrajetExpirationTimeWithProposition Int      @default(120)
  finishedCourseAutoTime              Int      @default(5)
  finishedCourseReminder              Int      @default(120)
  updateProfileClientTime             Int      @default(1440)
  updateProfileDriverTime             Int      @default(2880)
  allowUserToCreateTrajetDate         DateTime @default(dbgenerated("('2025-10-01')")) @db.Date
}

model payments {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now()) @db.DateTime(6)
  updatedAt         DateTime @default(now()) @db.DateTime(6)
  provider          String   @db.VarChar(255)
  transactionId     String   @db.VarChar(255)
  transactionStatus String   @db.VarChar(255)
  amount            Int
  courseId          Int?     @unique(map: "REL_7b423371808e91621e2aa77438")
  courses           courses? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_7b423371808e91621e2aa77438b")
}

model propositions {
  id              Int         @id @default(autoincrement())
  createdAt       DateTime    @default(now()) @db.DateTime(6)
  updatedAt       DateTime    @default(now()) @db.DateTime(6)
  prix            Decimal     @db.Decimal(10, 0)
  precisionDepart String?     @db.VarChar(255)
  precisionArrive String?     @db.VarChar(255)
  isValidated     Int         @default(0) @db.TinyInt
  latDriver       Decimal     @db.Decimal(10, 4)
  lngDriver       Decimal     @db.Decimal(10, 4)
  isCanceled      Int         @default(0) @db.TinyInt
  trajetId        Int?
  chauffeurId     Int?
  trajets         trajets?    @relation(fields: [trajetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_103cc6947d338c2835a0e380968")
  chauffeurs      chauffeurs? @relation(fields: [chauffeurId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_3a5fc9a316c16fc920900677b77")

  @@index([trajetId], map: "FK_103cc6947d338c2835a0e380968")
  @@index([chauffeurId], map: "FK_3a5fc9a316c16fc920900677b77")
}

model requeststats {
  id          Int                     @id @default(autoincrement())
  createdAt   DateTime                @default(now()) @db.DateTime(6)
  updatedAt   DateTime                @default(now()) @db.DateTime(6)
  requestId   String                  @db.VarChar(255)
  driverId    String                  @db.VarChar(255)
  available   requeststats_available?
  minPrice    Int?
  maxPrice    Int?
  respondedAt DateTime                @default(now()) @db.Timestamp(6)
}

model sequelizemeta {
  name String @id @unique(map: "name") @db.VarChar(255)
}

model signupclicks {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @db.DateTime(6)
  updatedAt  DateTime @default(now()) @db.DateTime(6)
  sessionId  String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(255)
  deviceType String?  @db.VarChar(50)
  userAgent  String?  @db.VarChar(255)

  @@index([sessionId], map: "IDX_517c0c5083fab78d65fb82a447")
  @@index([createdAt], map: "IDX_SignUpClicks_createdAt")
  @@index([deviceType], map: "IDX_add75d8c941b817b222e15b75a")
}

model trajets {
  id                                   Int            @id @default(autoincrement())
  createdAt                            DateTime       @default(now()) @db.DateTime(6)
  updatedAt                            DateTime       @default(now()) @db.DateTime(6)
  etat                                 trajets_etat   @default(EN_COURS)
  latDep                               Decimal        @db.Decimal(10, 4)
  longDep                              Decimal        @db.Decimal(10, 4)
  latArr                               Decimal        @db.Decimal(10, 4)
  longArr                              Decimal        @db.Decimal(10, 4)
  precisionDepart                      String?        @db.VarChar(255)
  precisionArrive                      String?        @db.VarChar(255)
  ClientId                             Int
  VilleDepartId                        Int?
  VilleArriveId                        Int?
  heureDepart                          DateTime?      @db.DateTime(0)
  heureArrive                          DateTime?      @db.DateTime(0)
  autoCancel                           Int?           @db.TinyInt
  courses                              courses[]
  feed_back                            feed_back[]
  position                             position[]
  propositions                         propositions[]
  villes_trajets_VilleArriveIdTovilles villes?        @relation("trajets_VilleArriveIdTovilles", fields: [VilleArriveId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_0ad95b13c1c97e85fcc64487c35")
  villes_trajets_VilleDepartIdTovilles villes?        @relation("trajets_VilleDepartIdTovilles", fields: [VilleDepartId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_78b3d13872163dfa1af1d6a23de")
  clients                              clients        @relation(fields: [ClientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_849418e69a3b701f9fbe627a16b")

  @@index([VilleArriveId], map: "FK_0ad95b13c1c97e85fcc64487c35")
  @@index([VilleDepartId], map: "FK_78b3d13872163dfa1af1d6a23de")
  @@index([ClientId], map: "FK_849418e69a3b701f9fbe627a16b")
}

